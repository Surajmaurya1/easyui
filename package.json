{
  "name": "easyui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run component:sync && tsc -b && vite build && npm run prerender && npm run seo:audit",
    "prerender": "tsx scripts/prerender.ts",
    "registry:generate": "tsx scripts/generate-registry.ts",
    "registry:validate": "tsx scripts/validate-registry.ts",
    "component:sync": "tsx scripts/generate-registry.ts && tsx scripts/validate-registry.ts",
    "component:new": "tsx scripts/component-new.ts",
    "seo:sitemap": "tsx scripts/generate-sitemap.ts",
    "seo:llms": "tsx scripts/generate-llms.ts",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
