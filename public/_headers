/site.webmanifest
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og-image.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/easyui-og-concept-v3.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/easyui-og-concept-v3.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icons.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/manifest.webmanifest
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
